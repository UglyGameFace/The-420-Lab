DISCORD_TOKEN=
DISCORD_GUILD_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NCBI_API_KEY=
OPENFDA_API_KEY=
LOG_LEVEL=INFO

# Conservative shared quota limits; optional overrides.
LAB_GLOBAL_MINUTE_LIMIT=15
LAB_GLOBAL_DAILY_LIMIT=400
LAB_GEMINI_MINUTE_LIMIT=2
LAB_GEMINI_DAILY_LIMIT=30
LAB_PROVIDER_MINUTE_LIMIT=45
LAB_PROVIDER_DAILY_LIMIT=1200
LAB_USER_10M_LIMIT=8
LAB_GUILD_HOUR_LIMIT=80
# Quota sqlite file. Use persistent storage where supported.
LAB_QUOTA_DB_PATH=lab-quotas.sqlite3

# Emergency switch: false disables all Gemini calls but keeps paper links.
LAB_AI_ENABLED=true
# Optional comma-separated guild IDs allowed to submit costly research requests.
# LAB_ALLOWED_GUILDS=123456789012345678

# Optional: only if you have a legally licensed Leafly-compatible CSV export.
# Supports Strain/Name, Rating, Effects, Flavor/Flavors. Never commit the CSV.
# LEAFLY_LICENSED_CSV_PATH=/data/leafly-authorized.csv

# Read-only CannaLib source-attributed strain facts; no key is necessary.
# No API response caching. Local global caps: 35/hour, 180/day.
CANNALIB_ENABLED=true
CANNALIB_API_KEY=

# Optional persistent storage for owner-licensed descriptions and per-guild
# opt-in ratings. Keep this on durable writable storage when available.
LAB_STRAIN_DB_PATH=strain-profiles.sqlite3

# Grower uploads require an owner-confirmed cross-process SQLite continuity test.
# Run /growerstorage action:arm, restart/redeploy, and action:verify.
# This prevents new photo uploads on storage whose continuity is unverified.
# ONLY override knowingly in a disposable staging environment with no real submissions.
LAB_GROWER_REQUIRE_STORAGE_PROOF=true

# Optional StrainAPI read-only fallback; no API key required.
STRAINAPI_ENABLED=true

# Free public Find My Seeds profile + independent review-count lookup.
# FINDMYSEEDS_ENABLED=true

# Optional: Pexels genuine cannabis flower photography with credited source.
# When unset, a real, credited Wikimedia Commons CC0 flower photo works.
# PEXELS_API_KEY=
# Optional: Cannlytics real-data strain lookups (requires authorized API key).
# CANNLYTICS_API_KEY=

# OPTIONAL durable Cloudflare R2 photo queue. Disabled until private Worker,
# private R2 bucket and authenticated intake have been provisioned/tested.
# Keeps RAM=256 in discloud.config; requires persisted LAB_STRAIN_DB_PATH.
LAB_GROWER_R2_QUEUE_ENABLED=false
# LAB_GROWER_QUEUE_ENDPOINT=https://the-weed-doctor-private-intake.<subdomain>.workers.dev
# LAB_GROWER_QUEUE_TOKEN= # Secret; must match Worker GROWER_INTAKE_TOKEN.
